##EXAMPLE THREE: database tables with referential integrity
CREATE TABLE Manufacturers(
                           ManufracturerID INT AUTO_INCREMENT,
                           Name VARCHAR(100),
                           Phone INT,
                           Address VARCHAR(100)
                           PRIMARY KEY(ManufacturerID)
                           );
CREATE TABLE Products(
                      ProductID INT AUTO_INCREMENT,
                      Name VARCHAR(100),
                      Size FLOAT,
                      Price FLOAT,
                      ManufacturerID INT,
                      PRIMARY KEY(ProductID),
                      FOREIGN KEY(ManufacturerID) REFERENCES Manufacturers(ManufacturerID) 
